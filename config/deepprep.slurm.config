// MRIPrepCloud Nextflow config for DeepPrep on Slurm 24.11: GPU shards (--gres=shard:1; bold_synthmorph_joint exclusive --gres=gpu:1),
// TF memory growth, per-task --nice = remaining critical path of the process (seconds, measured on a single-subject run)
// + a DS-I subject rank as tie-break (0 for other datasets), and CPU tasks on cpu-node or the GPU nodes' spill partitions.
singularity.enabled = true
singularity.autoMounts = false
// Pass Slurm's GPU assignment into the container (Nextflow launches singularity with `env -`)
singularity.envWhitelist = 'CUDA_VISIBLE_DEVICES,TF_FORCE_GPU_ALLOW_GROWTH'
singularity.runOptions = '--cleanenv \
    --home ${output_dir}/WorkDir/home \
    --bind /mydata:/mydata \
    --env TEMP=${output_dir}/WorkDir/tmp \
    --env TMP=${output_dir}/WorkDir/tmp \
    --env TMPDIR=${output_dir}/WorkDir/tmp \
    -B ${bids_dir} \
    -B ${output_dir} \
    -B ${subjects_dir} \
    -B ${fs_license_file}:/opt/freesurfer/license.txt \
'

// Faster task-state detection and trace output (Nextflow now runs on vm0, the NFS server)
executor {
    pollInterval = '2s'
    queueStatInterval = '10s'
    exitReadTimeout = '60s'
}
trace.overwrite = true

process {
    // errorStrategy = 'ignore'  // Uncomment only for non-critical tasks
    // Retry once or twice: transient NFS visibility races make a task fail right after writing its output
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'terminate' }
    maxRetries = 2
    beforeScript = { task.attempt > 1 ? 'sleep 30' : 'true' }
    executor = 'slurm'
    queue = 'cpu-node,cpu-spill2,cpu-spill3'  // CPU tasks run on Node4, or on GPU nodes' spare cores
    clusterOptions = { def pn = ['deepprep_init':0, 'bold_get_bold_file_in_bids':7, 'anat_get_t1w_file_in_bids':7, 'bold_create_summary':20, 'anat_create_subject_orig_dir':20, 'anat_create_summary':33, 'anat_motioncor':43, 'split_hemi_rawavg_mgz':50, 'split_hemi_orig_mgz':50, 'anat_segment':163, 'anat_reduce_to_aseg':197, 'anat_N4_bias_correct':213, 'anat_talairach_and_nu':257, 'anat_brainmask':263, 'split_hemi_brainmask_mgz':267, 'anat_paint_cc_to_aseg':317, 'anat_T1':580, 'bold_T1_to_2mm':587, 'bold_synthmorph_joint':773, 'qc_plot_norm_to_mni152':780, 'bold_anat_prepare':803, 'bold_fieldmap':830, 'anat_fill':947, 'subject_id_hemi_rh':950, 'split_hemi_aseg_presurf_mgz':950, 'split_hemi_filled_mgz':950, 'split_hemi_brain_finalsurfs_mgz':950, 'subject_id_hemi_lh':950, 'split_hemi_wm_mgz':950, 'anat_fastcsr_levelset':1025, 'anat_fastcsr_mksurface':1122, 'anat_autodet_gwstats':1132, 'anat_white_surface':1380, 'anat_cortex_label':1407, 'anat_cortex_hipamyg_label':1410, 'anat_hyporelabel':1420, 'anat_smooth_inflated':1424, 'anat_curv_stats':1432, 'anat_sphere':1675, 'anat_sphere_register':1714, 'anat_jacobian':1720, 'anat_cortparc_aparc':1737, 'anat_pial_surface':2045, 'anat_pctsurfcon':2052, 'qc_plot_surfparc':2100, 'qc_plot_volsurf':2130, 'anat_parcstats':2154, 'bold_aparc2aseg_presurf':2230, 'anat_ribbon':2334, 'anat_apas2aseg':2350, 'anat_aparc2aseg':2420, 'qc_plot_aparc_aseg':2460, 'qc_anat_create_report':2467, 'bold_pre_process':2674, 'qc_plot_tsnr':2684, 'bold_confounds_part1':2710, 'qc_plot_carpet':2717, 'bold_transform_chain':2770, 'bold_confounds_part2':2770, 'bold_confounds_combine':2777, 'qc_plot_bold_to_space':2794, 'qc_bold_create_report':2800]; def sn = ['sub-0028214':0, 'sub-0028206':1, 'sub-0028212':2, 'sub-0028205':3, 'sub-0028216':4, 'sub-0028201':5, 'sub-0028200':6, 'sub-0028198':7, 'sub-0028209':8, 'sub-0028208':9, 'sub-0028202':10, 'sub-0028211':11, 'sub-0028224':12, 'sub-0028199':13, 'sub-0028203':14, 'sub-0028219':15, 'sub-0028197':16, 'sub-0028223':17, 'sub-0028218':18, 'sub-0028210':19, 'sub-0028221':20, 'sub-0028204':21, 'sub-0028225':22, 'sub-0028222':23, 'sub-0028207':24, 'sub-0028220':25, 'sub-0028215':26, 'sub-0028217':27, 'sub-0028213':28]; def pname = (task.process ?: '').tokenize(':')[-1]; def mm = (task.tag ?: '') =~ /sub-\d+/; def srank = mm.find() ? (sn[mm.group()] ?: 0) : 0; def n = (pn[pname] ?: 0) + srank; " --chdir=${nextflow_work_dir} --nice=${n}" }
    container = "${container}"
    
    withLabel: with_gpu {
        queue = 'gpu-node'
        clusterOptions = { def pn = ['deepprep_init':0, 'bold_get_bold_file_in_bids':7, 'anat_get_t1w_file_in_bids':7, 'bold_create_summary':20, 'anat_create_subject_orig_dir':20, 'anat_create_summary':33, 'anat_motioncor':43, 'split_hemi_rawavg_mgz':50, 'split_hemi_orig_mgz':50, 'anat_segment':163, 'anat_reduce_to_aseg':197, 'anat_N4_bias_correct':213, 'anat_talairach_and_nu':257, 'anat_brainmask':263, 'split_hemi_brainmask_mgz':267, 'anat_paint_cc_to_aseg':317, 'anat_T1':580, 'bold_T1_to_2mm':587, 'bold_synthmorph_joint':773, 'qc_plot_norm_to_mni152':780, 'bold_anat_prepare':803, 'bold_fieldmap':830, 'anat_fill':947, 'subject_id_hemi_rh':950, 'split_hemi_aseg_presurf_mgz':950, 'split_hemi_filled_mgz':950, 'split_hemi_brain_finalsurfs_mgz':950, 'subject_id_hemi_lh':950, 'split_hemi_wm_mgz':950, 'anat_fastcsr_levelset':1025, 'anat_fastcsr_mksurface':1122, 'anat_autodet_gwstats':1132, 'anat_white_surface':1380, 'anat_cortex_label':1407, 'anat_cortex_hipamyg_label':1410, 'anat_hyporelabel':1420, 'anat_smooth_inflated':1424, 'anat_curv_stats':1432, 'anat_sphere':1675, 'anat_sphere_register':1714, 'anat_jacobian':1720, 'anat_cortparc_aparc':1737, 'anat_pial_surface':2045, 'anat_pctsurfcon':2052, 'qc_plot_surfparc':2100, 'qc_plot_volsurf':2130, 'anat_parcstats':2154, 'bold_aparc2aseg_presurf':2230, 'anat_ribbon':2334, 'anat_apas2aseg':2350, 'anat_aparc2aseg':2420, 'qc_plot_aparc_aseg':2460, 'qc_anat_create_report':2467, 'bold_pre_process':2674, 'qc_plot_tsnr':2684, 'bold_confounds_part1':2710, 'qc_plot_carpet':2717, 'bold_transform_chain':2770, 'bold_confounds_part2':2770, 'bold_confounds_combine':2777, 'qc_plot_bold_to_space':2794, 'qc_bold_create_report':2800]; def sn = ['sub-0028214':0, 'sub-0028206':1, 'sub-0028212':2, 'sub-0028205':3, 'sub-0028216':4, 'sub-0028201':5, 'sub-0028200':6, 'sub-0028198':7, 'sub-0028209':8, 'sub-0028208':9, 'sub-0028202':10, 'sub-0028211':11, 'sub-0028224':12, 'sub-0028199':13, 'sub-0028203':14, 'sub-0028219':15, 'sub-0028197':16, 'sub-0028223':17, 'sub-0028218':18, 'sub-0028210':19, 'sub-0028221':20, 'sub-0028204':21, 'sub-0028225':22, 'sub-0028222':23, 'sub-0028207':24, 'sub-0028220':25, 'sub-0028215':26, 'sub-0028217':27, 'sub-0028213':28]; def pname = (task.process ?: '').tokenize(':')[-1]; def mm = (task.tag ?: '') =~ /sub-\d+/; def srank = mm.find() ? (sn[mm.group()] ?: 0) : 0; def n = (pn[pname] ?: 0) + srank; " --chdir=${nextflow_work_dir} --gres=shard:1 --nice=${n}" }
        singularity.runOptions = '-e --nv \
        --cleanenv \
        --home ${output_dir}/WorkDir/home \
        --bind /mydata:/mydata \
        --env TEMP=${output_dir}/WorkDir/tmp \
        --env TMP=${output_dir}/WorkDir/tmp \
        --env TMPDIR=${output_dir}/WorkDir/tmp \
        -B ${bids_dir} \
        -B ${output_dir} \
        -B ${subjects_dir} \
        -B ${fs_license_file}:/opt/freesurfer/license.txt \
        '
        }

    
    // bold_synthmorph_joint needs ~17 GB VRAM (measured, TF memory growth on): exclusive GPU, no shard sharing.
    // nice 2000 (below the anat GPU steps): an exclusive job that outranks the shard tasks monopolizes all GPUs and stalls every anat chain (exp10 attempt 2)
    
    withName: 'bold_synthmorph_joint' {
    
        queue = 'gpu-node'
    
        clusterOptions = { def pn = ['deepprep_init':0, 'bold_get_bold_file_in_bids':7, 'anat_get_t1w_file_in_bids':7, 'bold_create_summary':20, 'anat_create_subject_orig_dir':20, 'anat_create_summary':33, 'anat_motioncor':43, 'split_hemi_rawavg_mgz':50, 'split_hemi_orig_mgz':50, 'anat_segment':163, 'anat_reduce_to_aseg':197, 'anat_N4_bias_correct':213, 'anat_talairach_and_nu':257, 'anat_brainmask':263, 'split_hemi_brainmask_mgz':267, 'anat_paint_cc_to_aseg':317, 'anat_T1':580, 'bold_T1_to_2mm':587, 'bold_synthmorph_joint':773, 'qc_plot_norm_to_mni152':780, 'bold_anat_prepare':803, 'bold_fieldmap':830, 'anat_fill':947, 'subject_id_hemi_rh':950, 'split_hemi_aseg_presurf_mgz':950, 'split_hemi_filled_mgz':950, 'split_hemi_brain_finalsurfs_mgz':950, 'subject_id_hemi_lh':950, 'split_hemi_wm_mgz':950, 'anat_fastcsr_levelset':1025, 'anat_fastcsr_mksurface':1122, 'anat_autodet_gwstats':1132, 'anat_white_surface':1380, 'anat_cortex_label':1407, 'anat_cortex_hipamyg_label':1410, 'anat_hyporelabel':1420, 'anat_smooth_inflated':1424, 'anat_curv_stats':1432, 'anat_sphere':1675, 'anat_sphere_register':1714, 'anat_jacobian':1720, 'anat_cortparc_aparc':1737, 'anat_pial_surface':2045, 'anat_pctsurfcon':2052, 'qc_plot_surfparc':2100, 'qc_plot_volsurf':2130, 'anat_parcstats':2154, 'bold_aparc2aseg_presurf':2230, 'anat_ribbon':2334, 'anat_apas2aseg':2350, 'anat_aparc2aseg':2420, 'qc_plot_aparc_aseg':2460, 'qc_anat_create_report':2467, 'bold_pre_process':2674, 'qc_plot_tsnr':2684, 'bold_confounds_part1':2710, 'qc_plot_carpet':2717, 'bold_transform_chain':2770, 'bold_confounds_part2':2770, 'bold_confounds_combine':2777, 'qc_plot_bold_to_space':2794, 'qc_bold_create_report':2800]; def sn = ['sub-0028214':0, 'sub-0028206':1, 'sub-0028212':2, 'sub-0028205':3, 'sub-0028216':4, 'sub-0028201':5, 'sub-0028200':6, 'sub-0028198':7, 'sub-0028209':8, 'sub-0028208':9, 'sub-0028202':10, 'sub-0028211':11, 'sub-0028224':12, 'sub-0028199':13, 'sub-0028203':14, 'sub-0028219':15, 'sub-0028197':16, 'sub-0028223':17, 'sub-0028218':18, 'sub-0028210':19, 'sub-0028221':20, 'sub-0028204':21, 'sub-0028225':22, 'sub-0028222':23, 'sub-0028207':24, 'sub-0028220':25, 'sub-0028215':26, 'sub-0028217':27, 'sub-0028213':28]; def pname = (task.process ?: '').tokenize(':')[-1]; def mm = (task.tag ?: '') =~ /sub-\d+/; def srank = mm.find() ? (sn[mm.group()] ?: 0) : 0; def n = 2000 + srank; " --chdir=${nextflow_work_dir} --gres=gpu:1 --nice=${n}" }
    
    }
   
    
}
